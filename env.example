LINEAR_API_KEY=lin_api_xx
# Agent CLI driven by agent-bridge.mjs (src/agent-bridges): claude (default) | opencode. AGENT_MODEL overrides its model
# (claude: Claude Code's own default; opencode: google/gemini-flash-latest).
AGENT=claude
AGENT_MODEL=
# Folder where agent sessions run and resume (cd AGENT_ROOT && <agent resume command>). Default: the folder above dev-deck.
AGENT_ROOT=
